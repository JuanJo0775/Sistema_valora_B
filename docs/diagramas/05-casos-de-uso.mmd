flowchart LR
  CON(["Consumidor"]):::persona
  REP(["Reportante"]):::persona
  COM(["Comercio"]):::persona
  MOD(["Moderador"]):::persona
  subgraph G1["Consultar · corte 2"]
    direction TB
    U1(["Buscar producto"]):::nucleo
    U2(["Comparar precios por unidad"]):::nucleo
    U3(["Armar canasta y ver plan de compra"]):::nucleo
    U7(["Marcar precio como dudoso"]):::nucleo
  end
  subgraph G2["Aportar · corte 2"]
    direction TB
    U4(["Registrarse e iniciar sesión"]):::soporte
    U5(["Registrar precio en modo góndola"]):::soporte
    U6(["Registrar sin conexión"]):::soporte
    U13(["Ver mis aportes"]):::soporte
  end
  subgraph G3["Comercio · corte 3"]
    direction TB
    U8(["Crear y verificar perfil"]):::evol
    U9(["Publicar precios oficiales"]):::evol
    U10(["Publicar promociones con reglas"]):::evol
    U14(["Atender discrepancias"]):::evol
  end
  subgraph G4["Moderar · corte 2"]
    direction TB
    U11(["Revisar cola de reportes"]):::datos
    U12(["Gestionar cuentas y comercios"]):::datos
  end
  CON --> G1
  REP --> G2
  COM --> G3
  MOD --> G4

classDef persona fill:#FFD7A8,stroke:#C2570C,stroke-width:2px,color:#3A2414
classDef sistema fill:#FD8A2E,stroke:#C2570C,stroke-width:2px,color:#2A1405
classDef nucleo fill:#FFE3C7,stroke:#F08A24,stroke-width:2px,color:#3A2414
classDef soporte fill:#FFF4D6,stroke:#E3A21A,stroke-width:2px,color:#3A2414
classDef evol fill:#FFE6DC,stroke:#E06A3A,stroke-width:2px,stroke-dasharray:6 4,color:#3A2414
classDef externo fill:#F4EFE8,stroke:#A39788,stroke-width:1.5px,stroke-dasharray:4 3,color:#4A3F35
classDef datos fill:#FFF8EC,stroke:#C98A2B,stroke-width:2px,color:#3A2414
classDef dominio fill:#FFFDF7,stroke:#8A4B14,stroke-width:2.5px,color:#3A2414
classDef nota fill:#FFFBEA,stroke:#E8D49A,stroke-width:1px,color:#6B5530
