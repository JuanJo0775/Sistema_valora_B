%%{init: {"theme":"base","themeVariables":{"fontFamily":"DejaVu Sans, Verdana, Arial, sans-serif","fontSize":"14px","primaryColor":"#FFF1DF","primaryBorderColor":"#F08A24","primaryTextColor":"#3A2414","secondaryColor":"#FFF7D6","tertiaryColor":"#FFFBF4","lineColor":"#B8692A","textColor":"#3A2414","clusterBkg":"#FFFBF4","clusterBorder":"#E8C9A0","edgeLabelBackground":"#FFFFFF","actorBkg":"#FFE3C7","actorBorder":"#F08A24","actorTextColor":"#3A2414","actorLineColor":"#E8B98A","signalColor":"#8A4B14","signalTextColor":"#3A2414","labelBoxBkgColor":"#FFE3C7","labelBoxBorderColor":"#F08A24","labelTextColor":"#3A2414","loopTextColor":"#8A4B14","noteBkgColor":"#FFF7D6","noteBorderColor":"#E3A21A","noteTextColor":"#3A2414","activationBkgColor":"#FFD7A8","activationBorderColor":"#F08A24","sequenceNumberColor":"#FFFFFF"}}}%%
flowchart LR
  subgraph F["1 · De dónde salen los precios"]
    direction TB
    R(["Reportante<br/>en la góndola"]):::persona
    C(["Comercio<br/>verificado"]):::persona
    E(["Equipo Valora<br/>siembra inicial"]):::persona
    S[("SIPSA · DANE<br/>solo referencia mayorista")]:::externo
  end
  subgraph A["2 · Entrada"]
    direction TB
    PWA["App web instalable PWA<br/>cola sin conexión"]:::nucleo
    API["API REST /v1<br/>sesión · roles · validación"]:::nucleo
  end
  subgraph P["3 · Procesamiento"]
    direction TB
    PR["pricing<br/>guarda el reporte<br/>solo inserción"]:::nucleo
    RL["reliability<br/>confianza y anómalos"]:::nucleo
    MD{"¿Precio raro?<br/>más de 40 % de la mediana"}:::soporte
    MO(["Moderador<br/>revisa y decide"]):::persona
  end
  subgraph L["4 · Lectura rápida"]
    direction TB
    CP[("price_current<br/>precio vigente precalculado")]:::datos
    CM["comparison<br/>orden neutral · unidad base"]:::nucleo
  end
  subgraph O["5 · Lo que ve la gente"]
    direction TB
    U1(["Consumidor<br/>compara y arma su canasta"]):::persona
    U2["Comercio<br/>ve diferencias con la comunidad"]:::evol
  end
  R --> PWA
  C -->|"precio oficial · promoción"| API
  E -->|"carga manual con evidencia"| API
  S -.->|"rango de referencia"| RL
  PWA -->|"HTTPS + clave única"| API
  API --> PR
  PR -->|"evento PrecioReportado"| RL
  RL --> MD
  MD -->|"no"| CP
  MD -->|"sí: en revisión"| MO
  MO -->|"aprueba"| CP
  MO -.->|"descarta"| X(["fuera de la comparación"]):::externo
  API -->|"oficial: actualización inmediata"| CP
  CP --> CM
  CM --> U1
  CM --> U2

classDef persona fill:#FFD7A8,stroke:#C2570C,stroke-width:2px,color:#3A2414
classDef sistema fill:#FD8A2E,stroke:#C2570C,stroke-width:2px,color:#2A1405
classDef nucleo fill:#FFE3C7,stroke:#F08A24,stroke-width:2px,color:#3A2414
classDef soporte fill:#FFF4D6,stroke:#E3A21A,stroke-width:2px,color:#3A2414
classDef evol fill:#FFE6DC,stroke:#E06A3A,stroke-width:2px,stroke-dasharray:6 4,color:#3A2414
classDef externo fill:#F4EFE8,stroke:#A39788,stroke-width:1.5px,stroke-dasharray:4 3,color:#4A3F35
classDef datos fill:#FFF8EC,stroke:#C98A2B,stroke-width:2px,color:#3A2414
classDef dominio fill:#FFFDF7,stroke:#8A4B14,stroke-width:2.5px,color:#3A2414
classDef nota fill:#FFFBEA,stroke:#E8D49A,stroke-width:1px,color:#6B5530
