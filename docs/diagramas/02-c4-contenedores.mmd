flowchart TB
  CON(["Consumidor / Reportante"]):::persona
  COM(["Comercio"]):::persona
  MOD(["Moderador"]):::persona
  subgraph DEV["Dispositivo del usuario"]
    direction LR
    WEB["<b>Aplicación web PWA</b><br/><small>TypeScript · Next.js (propuesto, ADR-017)<br/>Áreas: / · /comercios · /moderacion</small>"]:::nucleo
    IDB[("<b>Cola local</b><br/><small>IndexedDB · reportes<br/>pendientes de envío</small>")]:::datos
  end
  subgraph SRV["Servidor de Valora · un solo despliegue (ADR-001)"]
    direction LR
    PX["<b>Proxy HTTPS</b><br/><small>Caddy · certificados</small>"]:::soporte
    APP["<b>API · monolito modular</b><br/><small>Node.js + TypeScript<br/>Express o NestJS (ADR-018)<br/>REST /v1 + OpenAPI 3</small>"]:::nucleo
    JOB["<b>Trabajos diferidos</b><br/><small>Mismo proceso · lee el outbox<br/>score, anómalos, importaciones</small>"]:::nucleo
  end
  DB[("<b>Base de datos</b><br/><small>PostgreSQL + PostGIS (ADR-003)<br/>un esquema por módulo</small>")]:::datos
  SIP[("SIPSA · DANE<br/><small>archivos públicos</small>")]:::externo
  CON --> WEB
  COM --> WEB
  MOD --> WEB
  WEB <-->|"guarda / vacía la cola"| IDB
  WEB -->|"HTTPS · JSON · cookie de sesión"| PX
  PX --> APP
  APP -->|"SQL · transacciones + outbox"| DB
  JOB -->|"lee eventos · escribe resultados"| DB
  APP -.->|"publica eventos internos"| JOB
  SIP -.->|"CSV cargado por el equipo"| APP

classDef persona fill:#FFD7A8,stroke:#C2570C,stroke-width:2px,color:#3A2414
classDef sistema fill:#FD8A2E,stroke:#C2570C,stroke-width:2px,color:#2A1405
