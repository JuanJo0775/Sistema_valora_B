  IMPORT_BATCH ||--o{ SOURCE_RECORD : "contiene"
  PRODUCT {
    uuid id PK
    string nombre
    uuid categoria_id FK
  }
  PRESENTATION {
    uuid id PK
    uuid producto_id FK
    string codigo_barras
    decimal cantidad
    string unidad_base "g, ml, und"
  }
  ESTABLISHMENT {
    uuid id PK
    string nombre
    string tipo "barrio, mini, super"
    geography ubicacion "PostGIS"
  }
  PRICE_REPORT {
    uuid id PK
    uuid presentacion_id FK
    uuid establecimiento_id FK
    string reporter_pseudonym
    int precio_cop
    timestamp observed_at
    timestamp received_at
    string idempotency_key UK
  }
  PRICE_CURRENT {
    uuid presentacion_id PK
    uuid establecimiento_id PK
    int precio_cop
    decimal precio_unidad_base
    string fuente "comunidad, oficial"
    string confiabilidad
    timestamp stale_after
    timestamp expired_after
  }
  MODERATION_ITEM {
    uuid id PK
    uuid reporte_id FK
    string motivo
    string decision
  }
  USER {
    uuid id PK
    string correo
    string rol
    string version_politica
  }
  COMMERCE_PROFILE {
    uuid id PK
    uuid establecimiento_id FK
    bool verificado
  }
  OFFICIAL_PRICE {
    uuid id PK
    uuid presentacion_id FK
    int precio_cop
  }
  PROMOTION {
    uuid id PK
    string tipo "pct, especial, XxY"
    date hasta
  }
  CATEGORY {
    uuid id PK
    int ttl_dias
  }
  IMPORT_BATCH {
    uuid id PK
    string fuente
    date fecha_corte
  }
  SOURCE_RECORD {
    uuid id PK
    string producto_ref
    int precio
  }
