erDiagram
  PRODUCT ||--o{ PRESENTATION : "tiene"
  CATEGORY ||--o{ PRODUCT : "agrupa"
  PRESENTATION ||--o{ PRICE_REPORT : "se reporta"
  ESTABLISHMENT ||--o{ PRICE_REPORT : "en"
  USER ||--o{ PRICE_REPORT : "seudónimo"
  PRICE_REPORT ||--o| MODERATION_ITEM : "puede ir a"
  PRESENTATION ||--o{ PRICE_CURRENT : "precio vigente"
  ESTABLISHMENT ||--o{ PRICE_CURRENT : "en"
  ESTABLISHMENT ||--o| COMMERCE_PROFILE : "reclama"
  COMMERCE_PROFILE ||--o{ OFFICIAL_PRICE : "publica"
