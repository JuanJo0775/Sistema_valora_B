# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://valora:valora@localhost:5432/valora_dev
DATABASE_URL_TEST=postgresql://valora:valora@localhost:5432/valora_test
# Valor de ejemplo: genera uno propio y aleatorio para tu entorno. Firma el token CSRF (ADR-014).
SESSION_SECRET=cambia-este-secreto
# Valor de ejemplo: genera uno propio y aleatorio. Firma la clave seudónima del reportante (#31);
# no lo cambies una vez en uso, porque las reputaciones quedan asociadas a esa clave.
REPORTER_KEY_SECRET=cambia-este-otro-secreto
# Repartidor de eventos (ADR-015): valores iniciales calibrables
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
# Fotos de productos (ADR-020): carpeta donde se guardan (fuera de Git) y su dirección pública.
# La API sirve esa carpeta en /media mientras no se decida el proveedor (ADR-012).
MEDIA_DIR=media
MEDIA_PUBLIC_URL=http://localhost:3000/media
# Proxies delante de la API para leer la IP real del cliente (ADR-012). En local 0; en Render 2.
TRUST_PROXY=0
# Fotos en Supabase Storage (ADR-022). Déjalo vacío en local: las fotos van a MEDIA_DIR.
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=productos
# Correo de verificación (ADR-029). Con «console» (por defecto) el enlace se muestra en el registro de
# desarrollo y no se envía nada. Con «resend» las otras tres variables son obligatorias.
EMAIL_PROVIDER=console
# true (por defecto): registrar precios exige el correo verificado. En producción con EMAIL_PROVIDER=console
# la API no arranca si es true; ponlo en false hasta configurar el proveedor de correo.
REQUIRE_VERIFIED_EMAIL=true
# EMAIL_API_KEY=re_...
# EMAIL_FROM=Valora <no-responder@tu-dominio>
# Dirección pública de la PWA: base de los enlaces del correo (sin barra final).
# APP_URL=http://localhost:5173
