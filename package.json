{
  "name": "sistema-valora-b",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de Valora: API REST del monolito modular",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "nest start --entryFile seed",
    "db:seed-moderador": "nest start --entryFile seed-moderator",
    "seed:imagenes": "nest start --entryFile seed-images",
    "seed:espejo-fotos": "nest start --entryFile seed-mirror-images",
    "identity:set-role": "nest start --entryFile set-role --",
    "comparison:rebuild-history": "nest start --entryFile rebuild-history",
    "quality:accuracy": "nest start --entryFile accuracy",
    "smoke": "node --experimental-strip-types --no-warnings test/smoke/smoke.ts",
    "reliability:evaluate": "jest test/integration/reliability-detection.spec.ts --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "yaml": "^2.9.1"
  }
}
