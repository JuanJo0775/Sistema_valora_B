# Plantilla de producción del backend (Render). Sin valores secretos: se llenan en Render y se pega todo en
# Render > servicio > Environment > "Add from .env". No guardes este archivo con valores en Git.
#
# --- Ya los pone render.yaml (no hace falta pegarlos): NODE_ENV, PORT, TRUST_PROXY, OUTBOX_*, MEDIA_DIR,
#     SUPABASE_BUCKET, REQUIRE_VERIFIED_EMAIL, SESSION_SECRET (se genera solo).

# Neon > tu proyecto > "Connect" > rol del proyecto > cadena "Pooled connection" (termina en ?sslmode=require).
DATABASE_URL=
# La validación la exige; en producción puede ser la misma cadena de Neon.
DATABASE_URL_TEST=

# El MISMO valor que usa hoy el servicio viejo (Render viejo > Environment > REPORTER_KEY_SECRET).
# Si cambia, las reputaciones existentes se pierden.
REPORTER_KEY_SECRET=

# No se usa con Supabase, pero la validación la exige.
MEDIA_PUBLIC_URL=https://valora-api.onrender.com/media

# Supabase > Project Settings > API Keys > "Secret key" (empieza con sb_secret_).
SUPABASE_URL=https://smcujgkbygdrredlwiyu.supabase.co
SUPABASE_SECRET_KEY=

# Correo: mientras no haya proveedor, console (no envía nada).
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
APP_URL=https://sistema-valora-f.vercel.app
